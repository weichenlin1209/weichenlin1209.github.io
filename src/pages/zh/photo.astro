---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { ui } from '../../i18n';

const t = ui.zh;
---

<BaseLayout lang="zh" title={t.photoTitle}>
  <div class="max-w-4xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">{t.photoEyebrow}</p>
    <div class="flex items-center justify-between gap-4 mb-8">
      <h1 class="text-3xl font-bold">{t.photoTitle}</h1>
      <a
        href="/zh/photo/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 p-2 rounded-full hover:bg-fg/10 transition-colors"
        aria-label="RSS 相簿訂閱"
        title="RSS 相簿訂閱"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z" />
        </svg>
      </a>
    </div>
    <AlbumCard lang="zh" />
  </div>
</BaseLayout>
