---
import MarkdownSpecPage from '../../components/MarkdownSpecPage.astro';
import { getEntry } from 'astro:content';
import { ui } from '../../i18n';
import { site } from '../../site.config';

const t = ui.zh;
const mdId = site.nowContentPath.zh.replace(/\.md$/, '');
const entry = await getEntry('markdown_zh', mdId);
const dateValue = entry?.data?.pubDate ?? entry?.data?.date;
const publishedDate =
  dateValue instanceof Date
    ? dateValue.toISOString().slice(0, 10)
    : typeof dateValue === 'string'
      ? dateValue.slice(0, 10)
      : undefined;
---

<MarkdownSpecPage lang="zh" collection="markdown_zh" mdId={mdId} eyebrow={t.nowEyebrow} title={t.nowTitle} publishedDate={publishedDate} />
