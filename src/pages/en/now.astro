---
import MarkdownSpecPage from '../../components/MarkdownSpecPage.astro';
import { getEntry } from 'astro:content';
import { ui } from '../../i18n';
import { site } from '../../site.config';

const t = ui.en;
const mdId = site.nowContentPath.en.replace(/\.md$/, '');
const entry = await getEntry('markdown_en', mdId);
const updated = typeof entry?.data?.updated === 'string' ? entry.data.updated : undefined;
---

<MarkdownSpecPage lang="en" collection="markdown_en" mdId={mdId} eyebrow={t.nowEyebrow} title={t.nowTitle} updated={updated} />
