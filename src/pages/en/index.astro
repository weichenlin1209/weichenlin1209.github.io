---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { ui, formatLongDate } from '../../i18n';
import { site } from '../../site.config';

const lang = 'en';
const t = ui[lang];
const posts = (await getCollection('blog_en', ({ data }) => !import.meta.env.PROD || !data.draft))
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));
const pinned = posts.slice(0, 4);
const recent = posts.slice(0, 6);
const hasHomeImage = site.homeImage && fs.existsSync('public' + site.homeImage);

const activity = Array.from({ length: 84 }, (_, index) => {
  const date = new Date();
  date.setDate(date.getDate() - (83 - index));
  const iso = date.toISOString().slice(0, 10);
  const count = posts.filter((post) => post.data.pubDate === iso).length;
  return { iso, count, level: Math.min(count, 3) };
});
---

<BaseLayout lang={lang}>
  <div class="max-w-6xl mx-auto px-4 md:px-8 pt-10 md:pt-14 pb-16">
    <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="lg:pt-2">
        <div class="flex items-center gap-4 lg:block">
          {hasHomeImage ? (
            <img src={site.homeImage} alt="Windson" class="w-20 h-20 md:w-28 md:h-28 rounded-full object-cover border border-fg/15" />
          ) : (
            <div class="w-20 h-20 md:w-28 md:h-28 rounded-full border border-fg/15 bg-fg/5 flex items-center justify-center text-3xl font-semibold text-fg/60">W</div>
          )}
          <div class="lg:mt-4">
            <h1 class="text-2xl font-semibold tracking-tight">{t.homeName}</h1>
            <p class="text-lg text-fg/55">{t.homeNameAlt}</p>
            <div class="mt-2 flex gap-1.5">
              {site.socials.map((s) => (
                <a
                  href={s.href}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class="rounded-md p-1.5 text-fg/55 hover:bg-fg/5 hover:text-accent transition-colors"
                  aria-label={s.label}
                  title={s.label}
                >
                  <SocialIcon name={s.icon} />
                </a>
              ))}
            </div>
          </div>
        </div>

        <p class="mt-4 text-sm leading-6 text-fg/70">{t.homeIntro}</p>

        <section class="mt-8">
          <div class="mb-4">
            <h2 class="text-base font-semibold">{t.homeActivity}</h2>
            <span class="text-xs text-fg/45">Last 12 weeks</span>
          </div>
          <div class="contribution-grid" aria-label={t.homeActivity}>
            {activity.map((day) => (
              <span class="contribution-cell" data-level={day.level} title={`${day.iso}: ${day.count} ${t.homeRepositories}`} />
            ))}
          </div>
          <div class="mt-3 flex items-center justify-end gap-1.5 text-[0.7rem] text-fg/45">
            <span>Less</span>
            <span class="contribution-cell w-3" data-level="0"></span>
            <span class="contribution-cell w-3" data-level="1"></span>
            <span class="contribution-cell w-3" data-level="2"></span>
            <span class="contribution-cell w-3" data-level="3"></span>
            <span>More</span>
          </div>
        </section>
      </aside>

      <main class="min-w-0">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{t.homeTitle}</h2>
        <p class="mt-6 text-sm leading-7 text-fg/70">{t.homeIntroLine1}</p>
        <p class="mt-5 text-sm leading-7 text-fg/70">{t.homeIntroLine2}</p>
        <p class="mt-5 text-sm leading-7 text-fg/70">{t.homeIntroLine3}</p>

        <section class="mt-8">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-base font-semibold">{t.homeLatest}</h2>
            <a href={`/${lang}/posts`} class="text-sm text-accent hover:underline">{t.homeViewAll}</a>
          </div>
          <div class="divide-y divide-fg/10 border-y border-fg/15">
            {recent.map((post) => (
              <a href={`/${lang}/posts/${post.id}`} class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between">
                <span class="font-medium group-hover:text-accent transition-colors">{post.data.title}</span>
                <time datetime={post.data.pubDate} class="shrink-0 text-xs text-fg/45 font-mono">{formatLongDate(post.data.pubDate)}</time>
              </a>
            ))}
          </div>
        </section>
      </main>
    </div>
  </div>
</BaseLayout>
