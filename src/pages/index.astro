<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/zh/" />
    <link rel="canonical" href="/zh/" />
    <title>Redirecting…</title>
  </head>
  <body>
    <script is:inline>location.replace('/zh/');</script>
    <a href="/zh/">Continue</a>
  </body>
</html>
