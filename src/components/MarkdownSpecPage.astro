---
// Markdown 规格页（about / now 共用）：渲染 specs collection 里的 markdown
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimateIn from './AnimateIn.astro';
import type { Lang } from '../site.config';

interface Props {
  lang: Lang;
  mdId: string;
  eyebrow: string;
  title: string;
}

const { lang, mdId, eyebrow, title } = Astro.props;
const collection = lang === 'zh' ? 'specs_zh' : 'specs_en';
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const entry = await getEntry(collection as any, mdId);
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let Content: any = null;
if (entry) {
  Content = (await render(entry)).Content;
}
---

<BaseLayout lang={lang} title={title}>
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <p class="text-xs tracking-[0.3em] uppercase text-fg/30 mb-3">{eyebrow}</p>
    <AnimateIn>
      <div class="prose prose-neutral dark:prose-invert max-w-none text-lg
                  prose-p:leading-relaxed prose-p:my-5 prose-p:text-fg
                  prose-headings:text-fg prose-headings:font-semibold prose-headings:mt-10 prose-headings:mb-5
                  prose-h2:text-2xl prose-h3:text-xl
                  prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                  prose-code:text-accent prose-code:bg-fg/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-base prose-code:font-normal
                  prose-pre:bg-fg/5 prose-pre:border prose-pre:border-fg/10 prose-pre:my-8 prose-pre:rounded-xl
                  prose-img:rounded-xl prose-img:my-8
                  prose-li:my-2 prose-li:leading-relaxed prose-li:text-fg
                  prose-blockquote:border-l-accent prose-blockquote:bg-fg/3 prose-blockquote:rounded-r-lg
                  prose-hr:border-fg/10 prose-hr:my-10
                  prose-strong:text-fg prose-strong:font-semibold
                  prose-table:border-fg/10">
        <Content />
      </div>
    </AnimateIn>
  </div>
</BaseLayout>
